{
  "name": "toolbox",
  "version": "0.1.0",
  "private": true,
  "description": "A small desktop app holding a growing stack of personal tools. First tool: a draw / type / paste canvas that exports to PDF.",
  "author": "Umut Akarsu",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.umutakarsu.toolbox",
    "productName": "PDF Maker",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "tools/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity"
    }
  }
}
